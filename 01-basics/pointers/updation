#include <stdio.h>
int n;
int *p;
void update(int n, int *p);

void update(int n, int *p){
    printf("The original value of n: %d",n);
    *p+=5;
    printf("The updated value of n: %d",*p);
}
int main(){
    printf("Enter a number: ");
    scanf("%d",&n);
    p=&n;
    update(n,p);
    return 0;
}
