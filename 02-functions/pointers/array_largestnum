#include <stdio.h>
int arr[10];
int l,*p;
int largest(int *p);
int largest(int *p){
    l=*p;
    for(int i=1;i<10;i++){
        if(*(p+i)>l){
            l=*(p+i);
        }
    }
    return l;
}
int main(){
    printf("Enter 10 numbers: ");
    for(int i=0; i<10;i++){
        scanf("%d",&arr[i]);
    }
    p=arr;
    printf("The largest number is: %d",largest(p));
}
