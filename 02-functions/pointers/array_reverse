#include <stdio.h>
int arr[10];
int *p,temp;
void reverse();
void reverse(int *p){
    for(int i=0; i<5; i++){
        temp=*(p+i);
        *(p+i)=*(p+(9-i));
        *(p+(9-i))=temp;
    }
    printf("The reversed array is:\n");
    for(int i=0;i<10;i++){
        printf("%d\n",arr[i]);
    }
}
int main(){
    printf("Enter 10 values:\n");
    for(int i=0;i<10;i++){
        scanf("%d",&arr[i]);
    }
    p=arr;
    reverse(p);
}
