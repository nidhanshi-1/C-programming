#include <stdio.h>
int arr[5];
int *p,s=0;
int sum(int *p){
     for(int i=0;i<5;i++){
        s=s+*(p+i);
    }
    return s;
}
int main(){
    printf("Enter 5 numbers:\n");
    for(int i=0;i<5;i++){
        scanf("%d",&arr[i]);
    }
    p=arr;
    printf("The sum of the values is: %d", sum(p));
}
